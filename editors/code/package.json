{
  "name": "crabviz",
  "displayName": "Crabviz",
  "description": "interactive call graph generator",
  "version": "0.5.0",
  "publisher": "chanhx",
  "author": {
    "name": "Chan HoCheung"
  },
  "icon": "assets/icon.png",
  "repository": {
    "url": "https://github.com/chanhx/crabviz"
  },
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "call graph"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "crabviz.generateCallGraph",
        "title": "Crabviz: Generate Call Graph"
      },
      {
        "command": "crabviz.generateFuncCallGraph",
        "title": "Crabviz: Generate Function Call Graph"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "crabviz.generateCallGraph",
          "when": "never"
        },
        {
          "command": "crabviz.generateFuncCallGraph",
          "when": "never"
        }
      ],
      "editor/context": [
        {
          "command": "crabviz.generateFuncCallGraph",
          "group": "crabviz",
          "when": "editorHasCallHierarchyProvider"
        }
      ],
      "explorer/context": [
        {
          "command": "crabviz.generateCallGraph",
          "group": "crabviz"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "18.15.0",
    "@types/vscode": "1.83.0",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.2",
    "@wasm-tool/wasm-pack-plugin": "^1.6.0",
    "wasm-pack": "^0.15.0",
    "eslint": "^10.8.1",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^7.2.2",
    "webpack-shell-plugin-next": "^2.3.3"
  },
  "dependencies": {
    "ignore": "^7.0.6"
  }
}